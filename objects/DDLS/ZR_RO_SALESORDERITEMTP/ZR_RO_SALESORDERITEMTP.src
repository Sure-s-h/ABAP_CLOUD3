@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Sales Order - Item'
define view entity ZR_RO_SalesOrderItemTP
  as select from zro_so_itm
  association to parent ZR_RO_SalesOrderTP as _SalesOrder
    on $projection.ParentUUID = _SalesOrder.OrderUUID
{
  key item_uuid             as ItemUUID,
      parent_uuid           as ParentUUID,
      item_position         as ItemPosition,
      product_id            as ProductID,
      @Semantics.quantity.unitOfMeasure: 'QuantityUnit'
      quantity              as Quantity,
      quantity_unit         as QuantityUnit,
      @Semantics.amount.currencyCode: 'CurrencyCode'
      net_price             as NetPrice,
      currency_code         as CurrencyCode,
      @Semantics.systemDateTime.localInstanceLastChangedAt: true
      local_last_changed_at as LocalLastChangedAt,
      _SalesOrder
}
